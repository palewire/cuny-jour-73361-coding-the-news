    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
  }

  .input-wrapper {
    display: flex;
    align-items: center;
    border: 2px solid #ddd;
  }

  .currency {
    padding: 0.75rem;
    background: #eee;
    font-weight: bold;
  }

  input[type="number"] {
    flex: 1;
    padding: 0.75rem;
    border: none;
    font-size: 1.25rem;
    width: 100%;
  }

  .result {
    padding: 1rem;
    background: var(--color-accent);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
