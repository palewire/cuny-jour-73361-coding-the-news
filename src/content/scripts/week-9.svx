  src="/screenshots/week-9/methodology-on-page.png"
  alt="The bottom of the page showing the last few ranked buildings and the methodology box below with a blue left border, explaining the data source and methodology"
  chromeTitle="Bronx Lead Paint Violations"
  chromeUrl="http://localhost:5174"
