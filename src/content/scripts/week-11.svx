## Part 5: Filtering the map

An interactive map becomes much more useful when readers can slice the data. Let's add a borough filter and a toggle for fatal-only incidents.

This is where we connect the reactive tools you already know — `$state` and `$derived` — to MapLibre's filtering system.

### Wiring filters to the map component

First, let's update `Map.svelte` to accept a `filter` prop and apply it to the layer. The challenge is that we need to update the map whenever the filter changes, but we don't want to rebuild the entire map. MapLibre has a method called `setFilter` that handles this efficiently.

Update `Map.svelte`:

```svelte
<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  let { data, filter = null } = $props();
  let container;

  $effect(() => {
    const map = new maplibregl.Map({
      container: container,
      style: 'https://tiles.openfreemap.org/styles/liberty',
      center: [-73.95, 40.75],
      zoom: 10
    });

    map.addControl(new maplibregl.NavigationControl());

    map.on('load', () => {
      map.addSource('shootings', {
        type: 'geojson',
        data: data
      });

      map.addLayer({
        id: 'shootings-layer',
        type: 'circle',
        source: 'shootings',
        paint: {
          'circle-radius': 4,
          'circle-color': '#e74c3c',
          'circle-opacity': 0.6
        }
      });

      map.on('click', 'shootings-layer', (e) => {
        const feature = e.features[0];
        const props = feature.properties;
        const coords = feature.geometry.coordinates;

        new maplibregl.Popup()
          .setLngLat(coords)
          .setHTML(`
            <strong>${props.date}</strong><br>
            ${props.time}<br>
            ${props.borough}, Precinct ${props.precinct}<br>
            ${props.fatal ? '<span style="color: #e74c3c; font-weight: bold;">Fatal</span>' : 'Non-fatal'}
          `)
          .addTo(map);
      });

      map.on('mouseenter', 'shootings-layer', () => {
        map.getCanvas().style.cursor = 'pointer';
      });

      map.on('mouseleave', 'shootings-layer', () => {
        map.getCanvas().style.cursor = '';
      });
    });

    return () => map.remove();
  });

  $effect(() => {
    if (!container) return;
    const map = container._map;
    if (!map || !map.getLayer('shootings-layer')) return;
    map.setFilter('shootings-layer', filter);
  });
</script>

<div class="map" bind:this={container}></div>

<style>
  .map {
    width: 100%;
    height: 500px;
  }
</style>
```

Wait — there's a problem. The second `$effect` needs access to the map object, but the map was created inside the first `$effect`. Let's restructure to store the map reference:

```svelte
<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  let { data, filter = null } = $props();
  let container;
  let map;
  let loaded = $state(false);

  $effect(() => {
    map = new maplibregl.Map({
      container: container,
      style: 'https://tiles.openfreemap.org/styles/liberty',
      center: [-73.95, 40.75],
      zoom: 10
    });

    map.addControl(new maplibregl.NavigationControl());

    map.on('load', () => {
      map.addSource('shootings', {
        type: 'geojson',
        data: data
      });

      map.addLayer({
        id: 'shootings-layer',
        type: 'circle',
        source: 'shootings',
        paint: {
          'circle-radius': 4,
          'circle-color': '#e74c3c',
          'circle-opacity': 0.6
        }
      });

      map.on('click', 'shootings-layer', (e) => {
        const feature = e.features[0];
        const props = feature.properties;
        const coords = feature.geometry.coordinates;

        new maplibregl.Popup()
          .setLngLat(coords)
          .setHTML(`
            <strong>${props.date}</strong><br>
            ${props.time}<br>
            ${props.borough}, Precinct ${props.precinct}<br>
            ${props.fatal ? '<span style="color: #e74c3c; font-weight: bold;">Fatal</span>' : 'Non-fatal'}
          `)
          .addTo(map);
      });

      map.on('mouseenter', 'shootings-layer', () => {
        map.getCanvas().style.cursor = 'pointer';
      });

      map.on('mouseleave', 'shootings-layer', () => {
        map.getCanvas().style.cursor = '';
      });

      loaded = true;
    });

    return () => map.remove();
  });

  $effect(() => {
    if (!loaded) return;
    map.setFilter('shootings-layer', filter);
  });
</script>

<div class="map" bind:this={container}></div>

<style>
  .map {
    width: 100%;
    height: 500px;
  }
</style>
```

The restructured version stores the map in a component-level variable and uses a `loaded` state variable to track when the map is ready. The second `$effect` watches `loaded` and `filter` — whenever either changes, it updates the map's filter. When `filter` is `null`, MapLibre shows all features.

### Building the filter controls

Now let's add the controls in `+page.svelte`:

```svelte
<script>
  import Map from '$lib/components/Map.svelte';
  import shootings from '$lib/data/shootings.geojson';

  let boroughFilter = $state('all');
  let fatalOnly = $state(false);

  let mapFilter = $derived(() => {
    let conditions = [];

    if (boroughFilter !== 'all') {
      conditions.push(['==', ['get', 'borough'], boroughFilter]);
    }

    if (fatalOnly) {
      conditions.push(['==', ['get', 'fatal'], true]);
    }

    if (conditions.length === 0) return null;
    if (conditions.length === 1) return conditions[0];
    return ['all', ...conditions];
  });
</script>

<h1>NYC Shooting Incidents</h1>

<div class="controls">
  <select bind:value={boroughFilter}>
    <option value="all">All boroughs</option>
    <option value="BRONX">Bronx</option>
    <option value="BROOKLYN">Brooklyn</option>
    <option value="MANHATTAN">Manhattan</option>
    <option value="QUEENS">Queens</option>
    <option value="STATEN ISLAND">Staten Island</option>
  </select>

  <label>
    <input type="checkbox" bind:checked={fatalOnly} />
    Fatal incidents only
  </label>
</div>

<Map data={shootings} filter={mapFilter} />
```

The `mapFilter` is a `$derived` value that builds a MapLibre [filter expression](https://maplibre.org/maplibre-style-spec/expressions/). These expressions use a Lisp-like syntax that looks odd at first:

- `['==', ['get', 'borough'], 'BRONX']` means "where the `borough` property equals 'BRONX'"
- `['all', expr1, expr2]` means "both conditions must be true"
- `null` means "no filter — show everything"

This syntax is specific to MapLibre. You don't need to memorize it — this is one of those cases where asking an AI assistant "how do I filter a MapLibre layer by a property value" will get you the right answer instantly.

Add some styles:

```css
.controls {
  display: flex;
  gap: 1rem;
  align-items: center;
  margin: 1rem 0;
}

select {
  padding: 0.5rem;
  font-size: 1rem;
  border: 2px solid #ddd;
}

label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9375rem;
}
```

Save and try the filters. Select "Bronx" from the dropdown and watch the dots outside the Bronx disappear. Check the "Fatal incidents only" box and see the map thin out further.

<Screenshot
  src="/screenshots/week-11/filters-working.png"
  alt="The map showing only Bronx shooting incidents after selecting 'Bronx' from the borough dropdown, with fewer dots visible and the fatal-only checkbox unchecked"
  chromeTitle="NYC Shooting Incidents"
  chromeUrl="http://localhost:5173"
  maxWidth="960px"
/>

This is the same reactive pattern you've used all semester — `$state` tracks the user's input, `$derived` computes a value from it, and the UI updates automatically. The only new part is that instead of filtering a list of HTML cards, we're filtering a layer on a map.

## Part 6: Adding an incident count

Let's show the reader how many incidents they're looking at. This connects the filters to a visible number that updates as they narrow the data.

We can count the filtered features using plain JavaScript. In `+page.svelte`, add a derived count:

```svelte {emphasize-lines="8-17"}
<script>
  import Map from '$lib/components/Map.svelte';
  import shootings from '$lib/data/shootings.geojson';

  let boroughFilter = $state('all');
  let fatalOnly = $state(false);

  let filteredCount = $derived(
    shootings.features.filter(f => {
      if (boroughFilter !== 'all' && f.properties.borough !== boroughFilter) return false;
      if (fatalOnly && !f.properties.fatal) return false;
      return true;
    }).length
  );

  let mapFilter = $derived(() => {
    let conditions = [];

    if (boroughFilter !== 'all') {
      conditions.push(['==', ['get', 'borough'], boroughFilter]);
    }

    if (fatalOnly) {
      conditions.push(['==', ['get', 'fatal'], true]);
    }

    if (conditions.length === 0) return null;
    if (conditions.length === 1) return conditions[0];
    return ['all', ...conditions];
  });
</script>
```

Display the count between the controls and the map:

```svelte
<p class="count">{filteredCount.toLocaleString()} incidents</p>
```

The `.toLocaleString()` method adds commas to large numbers — so `1247` becomes `1,247`.

Style the count:

```css
.count {
  font-size: 1.125rem;
  font-weight: bold;
  margin: 0 0 0.5rem;
}
```

Save and toggle the filters. The count should update instantly as you change the borough or toggle fatal-only.

