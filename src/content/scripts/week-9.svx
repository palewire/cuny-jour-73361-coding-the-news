  src="/screenshots/week-9/search-fixed-width.png"
  alt="The database header with the search input now constrained to a narrower width, matching the text content above it"
  chromeTitle="Bronx Lead Paint Violations"
  chromeUrl="http://localhost:5174"
  maxWidth="960px"
